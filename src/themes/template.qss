/* Hutaomu Editor - QSS 模板
   颜色：@<colorKey>（theme.json 的 colors）
   度量：@m.<metricKey>px（theme.json 的 metrics，T2 能力；缺省用内置默认值）
   新增主题只需一个 theme.json，不需要改样式。 */

QMainWindow, QDialog {
    background: @windowBg;
}

/* ---------- 标题栏 ---------- */

#TitleBar {
    background: @titleBarBg;
    border-bottom: 1px solid @separatorColor;
}
#titleLabel {
    color: @titleBarMutedFg;
    font-size: @m.fontSizeSmallpx;
    padding: 0px 8px;
}
#brandName {
    font-size: @m.fontSizeSmallpx;
}

QMenuBar {
    background: transparent;
    color: @menuFg;
    border: none;
    padding: 0px;
}
QMenuBar::item {
    padding: @m.menuBarItemPaddingVpx @m.menuBarItemPaddingHpx;
    background: transparent;
    border-radius: @m.cornerRadiuspx;
}
QMenuBar::item:selected {
    background: @menuHoverBg;
}
QMenuBar::item:pressed {
    background: @menuPressedBg;
}

#winMin, #winMax, #winClose {
    background: transparent;
    border: none;
    border-radius: 0px;
}
#winMin:hover, #winMax:hover {
    background: @winButtonHoverBg;
}
#winClose:hover {
    background: @winCloseHoverBg;
}

/* ---------- 活动栏 ---------- */

#ActivityBar {
    background: @activityBarBg;
    border: none;
}
#activityButton {
    background: transparent;
    border: none;
    border-left: 2px solid transparent;
    border-radius: 0px;
}
#activityButton:hover {
    border-left-color: @activityHoverBorder;
}
#activityButton:checked {
    border-left-color: @accent;
}

/* ---------- 侧边栏 / 资源管理器 / 搜索 ---------- */

#Sidebar, #searchPanel {
    background: @sidebarBg;
    border: none;
}
#sidebarHeader {
    background: @sidebarBg;
    border: none;
}
#sidebarTitle {
    color: @sidebarTitleFg;
    font-size: @m.fontSizeSmallpx;
    font-weight: 600;
}
#sidebarSubtitle {
    color: @sidebarText;
    font-size: @m.fontSizeSmallpx;
}
#sidebarButton {
    background: transparent;
    border: none;
    border-radius: @m.cornerRadiuspx;
    padding: @m.sidebarButtonPaddingpx;
}
#sidebarButton:hover {
    background: @sidebarButtonHoverBg;
}
#sidebarWelcome {
    background: @sidebarBg;
}
#welcomeHint {
    color: @welcomeHintFg;
    font-size: @m.fontSizeNormalpx;
    padding-bottom: 10px;
}
#welcomeButton {
    background: @accent;
    color: @buttonFg;
    border: none;
    border-radius: @m.cornerRadiuspx;
    padding: @m.welcomeButtonPaddingVpx @m.welcomeButtonPaddingHpx;
    font-size: @m.fontSizeNormalpx;
}
#welcomeButton:hover {
    background: @accentHover;
}
#explorerTree, #searchResults {
    background: @sidebarBg;
    color: @sidebarText;
    border: none;
    outline: 0;
    font-size: @m.fontSizeNormalpx;
}
/* ---------- 侧栏卡片化（主题形态：layout.json 的 sidebar.style = card） ---------- */

#Sidebar[cardStyle="card"], #searchPanel[cardStyle="card"], #outlinePanel[cardStyle="card"] {
    background: @editorBg;
    border: 1px solid @separatorColor;
    border-radius: @m.cornerRadiusLargepx;
}
/* 卡片内部各部件透明，让卡片底色统一 */
#Sidebar[cardStyle="card"] #sidebarHeader,
#Sidebar[cardStyle="card"] #sidebarWelcome,
#Sidebar[cardStyle="card"] #explorerTree,
#searchPanel[cardStyle="card"] #searchHeader,
#searchPanel[cardStyle="card"] #searchResults,
#outlinePanel[cardStyle="card"] #outlineHeader,
#outlinePanel[cardStyle="card"] #outlineTree {
    background: transparent;
}

#explorerTree::item, #searchResults::item {
    height: @m.treeRowHeightpx;
}
#explorerTree::item:hover, #searchResults::item:hover {
    background: @sidebarHoverBg;
}
#explorerTree::item:selected, #searchResults::item:selected {
    background: @sidebarSelectedBg;
    color: @sidebarSelectedFg;
}
#searchInput {
    background: @editorBg;
    color: @editorFg;
    border: 1px solid @separatorColor;
    border-radius: @m.cornerRadiuspx;
    padding: @m.inputPaddingVpx @m.inputPaddingHpx;
}

/* ---------- 分隔条 ---------- */

#mainSplitter::handle, #editorSplitter::handle, #sideSplitter::handle {
    background: @sashColor;
}

/* ---------- 标签页 ---------- */

QTabWidget::pane {
    border: none;
    background: @editorBg;
}
QTabBar {
    background: @tabBarBg;
}
QTabBar::tab {
    background: @tabBg;
    color: @tabFg;
    padding: @m.tabPaddingVpx @m.tabPaddingHpx;
    margin-right: 1px;
    border-top: 2px solid transparent;
}
QTabBar::tab:selected {
    background: @tabActiveBg;
    color: @tabActiveFg;
    border-top: 2px solid @accent;
}
QTabBar::tab:hover:!selected {
    background: @tabHoverBg;
}
#newTabButton {
    background: transparent;
    border: none;
    border-radius: @m.cornerRadiuspx;
}

/* ---------- 标签形态（主题形态：layout.json 的 tabs.style） ---------- */

#editorTabs[tabStyle="underline"] QTabBar::tab {
    background: transparent;
    border-top: none;
    border-bottom: 2px solid transparent;
    padding: @m.tabPaddingVpx @m.tabPaddingHpx;
    margin-right: 2px;
}
#editorTabs[tabStyle="underline"] QTabBar::tab:selected {
    background: transparent;
    border-bottom: 2px solid @accent;
    color: @tabActiveFg;
}
#editorTabs[tabStyle="underline"] QTabBar::tab:hover:!selected {
    background: transparent;
    border-bottom-color: @separatorColor;
}

#editorTabs[tabStyle="pill"] QTabBar::tab {
    background: transparent;
    border: none;
    border-radius: @m.cornerRadiusLargepx;
    padding: @m.tabPaddingVpx @m.tabPaddingHpx;
    margin: 4px 4px 4px 0;
}
#editorTabs[tabStyle="pill"] QTabBar::tab:selected {
    background: @sidebarSelectedBg;
    color: @sidebarSelectedFg;
}
#editorTabs[tabStyle="pill"] QTabBar::tab:hover:!selected {
    background: @tabHoverBg;
}
#newTabButton:hover {
    background: @tabHoverBg;
}

/* ---------- 编辑器 ---------- */

/* 注意：这里刻意不设 background —— 编辑器底色由 palette Base 提供
   （applyPalette 设为 editorBg）。若在此设 background，QSS 会盖住 palette 的
   纹理画刷，主题的背景图（T3）就无法透出（实测：QSS background 存在时背景图不可见）。 */
QPlainTextEdit, QTextEdit {
    color: @editorFg;
    border: none;
    selection-background-color: @selectionBg;
}

/* ---------- 大纲 ---------- */

#outlineHeader {
    background: @sidebarBg;
    border: none;
}
#outlineTitle {
    color: @sidebarTitleFg;
    font-size: @m.fontSizeSmallpx;
    font-weight: 600;
}
#outlineTree {
    background: @sidebarBg;
    color: @sidebarText;
    border: none;
    outline: 0;
    font-size: @m.fontSizeNormalpx;
}
#outlineTree::item {
    height: @m.treeRowHeightpx;
}
#outlineTree::item:hover {
    background: @sidebarHoverBg;
}
#outlineTree::item:selected {
    background: @sidebarSelectedBg;
    color: @sidebarSelectedFg;
}

/* ---------- 预览面板 ---------- */

#previewHeader {
    background: @titleBarBg;
    border-bottom: 1px solid @separatorColor;
}
#previewHeaderTitle {
    color: @sidebarTitleFg;
    font-size: @m.fontSizeSmallpx;
    font-weight: 600;
}
#previewBrowser {
    background: @editorBg;
}

/* ---------- 查找条 ---------- */

#findBar {
    background: @titleBarBg;
    border: 1px solid @separatorColor;
    border-radius: @m.cornerRadiusLargepx;
}
#findEdit, #findBar QLineEdit {
    background: @editorBg;
    color: @editorFg;
    border: 1px solid @separatorColor;
    border-radius: @m.cornerRadiuspx;
    padding: @m.compactInputPaddingVpx @m.compactInputPaddingHpx;
}
#findStatus {
    color: @titleBarMutedFg;
}
#findBar QCheckBox {
    color: @menuFg;
}

/* ---------- 状态栏 ---------- */

QStatusBar {
    background: @statusBarBg;
    color: @statusBarFg;
    border-top: 1px solid @statusBarBorder;
}
QStatusBar QLabel {
    color: @statusBarFg;
    padding: 0px @m.statusBarPaddingHpx;
}

/* ---------- 滚动条 ---------- */

QScrollBar:vertical {
    background: transparent;
    width: @m.scrollbarWidthpx;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: @scrollbarHandle;
    border-radius: @m.cornerRadiuspx;
    min-height: 24px;
    margin: 2px 3px;
}
QScrollBar::handle:vertical:hover {
    background: @scrollbarHandleHover;
}
QScrollBar:horizontal {
    background: transparent;
    height: @m.scrollbarWidthpx;
    margin: 0px;
}
QScrollBar::handle:horizontal {
    background: @scrollbarHandle;
    border-radius: @m.cornerRadiuspx;
    min-width: 24px;
    margin: 3px 2px;
}
QScrollBar::handle:horizontal:hover {
    background: @scrollbarHandleHover;
}
QScrollBar::add-line, QScrollBar::sub-line {
    width: 0px;
    height: 0px;
}
QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

/* ---------- 菜单 / 对话框 / 提示 ---------- */

QMenu {
    background: @menuBg;
    color: @menuFg;
    border: 1px solid @menuBorder;
    padding: 4px 0px;
}
QMenu::item {
    padding: @m.menuItemPaddingVpx @m.menuItemPaddingRightpx @m.menuItemPaddingVpx @m.menuItemPaddingLeftpx;
}
QMenu::item:selected {
    background: @menuItemHoverBg;
    color: @menuItemHoverFg;
}
QMenu::item:disabled {
    color: @menuDisabledFg;
}
QMenu::separator {
    height: 1px;
    background: @separatorColor;
    margin: 4px 8px;
}

QToolTip {
    background: @tooltipBg;
    color: @tooltipFg;
    border: 1px solid @tooltipBorder;
    padding: @m.tooltipPaddingpx;
}

QMessageBox {
    background: @dialogBg;
}

QPushButton {
    background: @buttonBg;
    color: @buttonFg;
    border: none;
    border-radius: @m.cornerRadiuspx;
    padding: @m.buttonPaddingVpx @m.buttonPaddingHpx;
}
QPushButton:hover {
    background: @buttonHover;
}
QPushButton:disabled {
    background: @menuDisabledFg;
}

/* ---------- 主题画廊（设置页） ---------- */

#themeGallery {
    background: @sidebarBg;
    border: 1px solid @separatorColor;
    border-radius: @m.cornerRadiuspx;
}
#themeGallery::item {
    color: @sidebarText;
    padding: 4px;
    border-radius: @m.cornerRadiuspx;
}
#themeGallery::item:selected {
    background: @sidebarSelectedBg;
    color: @sidebarSelectedFg;
}
#themeGallery::item:hover:!selected {
    background: @sidebarHoverBg;
}
#themeHint, #themeFontHint {
    color: @sidebarTitleFg;
    font-size: @m.fontSizeSmallpx;
}

/* ---------- 电子表格查看器（名称框/编辑栏/表头/标签） ---------- */

#xlsxNameBox, #xlsxFormulaBox {
    background: @editorBg;
    color: @editorFg;
    border: 1px solid @separatorColor;
    border-radius: @m.cornerRadiuspx;
    padding: @m.compactInputPaddingVpx @m.compactInputPaddingHpx;
}
#xlsxNameBox { font-weight: 600; }
#xlsxFxLabel {
    color: @sidebarTitleFg;
    font-size: @m.fontSizeSmallpx;
    font-style: italic;
    font-weight: 600;
}
#xlsxTable {
    background: @editorBg;
    color: @editorFg;
    gridline-color: @separatorColor;
    selection-background-color: @selectionBg;
    selection-color: @editorFg;
}
#xlsxTable QHeaderView::section {
    background: @sidebarBg;
    color: @sidebarText;
    border: none;
    border-right: 1px solid @separatorColor;
    border-bottom: 1px solid @separatorColor;
    padding: 2px 8px;
    font-weight: 600;
}
#xlsxTable QTableCornerButton::section {
    background: @sidebarBg;
    border: none;
    border-right: 1px solid @separatorColor;
    border-bottom: 1px solid @separatorColor;
}
#xlsxSheets::tab {
    background: @tabBg;
    color: @tabFg;
    padding: @m.tabPaddingVpx @m.tabPaddingHpx;
    border-top-left-radius: @m.cornerRadiuspx;
    border-top-right-radius: @m.cornerRadiuspx;
}
#xlsxSheets::tab:selected {
    background: @tabActiveBg;
    color: @tabActiveFg;
    border-bottom: 2px solid @accent;
}

/* ---------- 设置页 ---------- */

#settingsTabs::tab {
    background: @tabBarBg;
    color: @tabFg;
    padding: 8px 20px;
    margin-right: 2px;
    border-top-left-radius: @m.cornerRadiuspx;
    border-top-right-radius: @m.cornerRadiuspx;
}
#settingsTabs::tab:selected {
    background: @editorBg;
    color: @tabActiveFg;
    border-bottom: 2px solid @accent;
}
#settingsBottomBar {
    background: @sidebarBg;
    border-top: 1px solid @separatorColor;
}
#settingsDialog QFormLayout {
    spacing: 8px;
}

/* ---------- 菜单栏 & 弹出菜单 ---------- */

QMenuBar {
    background: transparent;
    color: @menuFg;
    border: none;
    padding: 0px;
}
QMenuBar::item {
    padding: 6px 12px;
    background: transparent;
    border-radius: @m.cornerRadiuspx;
    margin: 0px 1px;
}
QMenuBar::item:selected {
    background: @menuHoverBg;
}
QMenuBar::item:pressed {
    background: @menuPressedBg;
}

QMenu {
    background: @menuBg;
    color: @menuFg;
    border: 1px solid @separatorColor;
    border-radius: 8px;
    padding: 6px 4px;
}
QMenu::item {
    padding: 7px 24px 7px 16px;
    border-radius: @m.cornerRadiuspx;
    margin: 1px 2px;
}
QMenu::item:selected {
    background: @menuHoverBg;
    color: @menuItemHoverFg;
}
QMenu::item:disabled {
    color: @menuDisabledFg;
}
QMenu::separator {
    height: 1px;
    background: @separatorColor;
    margin: 5px 10px;
}

/* ---------- 输入框/下拉框/数字框 ---------- */

QLineEdit, /* 注意：不要给编辑器设 background（会挡住主题背景图），见文件头部注释 */
QPlainTextEdit, QTextEdit {
    color: @editorFg;
    border: 1px solid @separatorColor;
    border-radius: 6px;
    padding: 5px 8px;
    selection-background-color: @selectionBg;
}
QLineEdit:focus {
    border-color: @accent;
}

QComboBox {
    background: @editorBg;
    color: @editorFg;
    border: 1px solid @separatorColor;
    border-radius: 6px;
    padding: 5px 10px;
    min-width: 80px;
}
QComboBox:focus {
    border-color: @accent;
}
QComboBox::drop-down {
    border: none;
    width: 24px;
}
QComboBox QAbstractItemView {
    background: @menuBg;
    color: @menuFg;
    border: 1px solid @separatorColor;
    border-radius: 6px;
    selection-background-color: @menuHoverBg;
    selection-color: @menuFg;
    outline: 0;
}

QSpinBox, QDoubleSpinBox {
    background: @editorBg;
    color: @editorFg;
    border: 1px solid @separatorColor;
    border-radius: 6px;
    padding: 4px 8px;
}
QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: @accent;
}

/* ---------- 按钮 ---------- */

QPushButton {
    background: @buttonBg;
    color: @buttonFg;
    border: none;
    border-radius: 6px;
    padding: 7px 18px;
    font-weight: 500;
}
QPushButton:hover {
    background: @buttonHover;
}
QPushButton:pressed {
    background: darken(@accent, 10%);
}
QPushButton:disabled {
    background: @menuDisabledFg;
    color: @windowBg;
}

/* ---------- 复选框/单选框 ---------- */

QCheckBox, QRadioButton {
    color: @editorFg;
    spacing: 8px;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid @separatorColor;
    border-radius: 4px;
    background: @editorBg;
}
QCheckBox::indicator:checked {
    background: @accent;
    border-color: @accent;
}
QRadioButton::indicator {
    border-radius: 9px;
}
QRadioButton::indicator:checked {
    background: @accent;
    border-color: @accent;
}

/* ---------- 列表/树 ---------- */

QListWidget, QTreeWidget, QTreeView {
    background: @sidebarBg;
    color: @sidebarText;
    border: 1px solid @separatorColor;
    border-radius: 8px;
    outline: 0;
    padding: 4px;
}
QListWidget::item, QTreeWidget::item {
    border-radius: 4px;
    margin: 1px 0px;
    padding: 3px 4px;
}
QListWidget::item:selected, QTreeWidget::item:selected {
    background: @sidebarSelectedBg;
    color: @sidebarSelectedFg;
}
QListWidget::item:hover, QTreeWidget::item:hover {
    background: @sidebarHoverBg;
}

/* ---------- 滚动条（圆角滑块） ---------- */

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: @scrollbarHandle;
    border-radius: 4px;
    min-height: 24px;
    margin: 2px 1px;
}
QScrollBar::handle:vertical:hover {
    background: @scrollbarHandleHover;
}
QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0px;
}
QScrollBar::handle:horizontal {
    background: @scrollbarHandle;
    border-radius: 4px;
    min-width: 24px;
    margin: 1px 2px;
}
QScrollBar::handle:horizontal:hover {
    background: @scrollbarHandleHover;
}
QScrollBar::add-line, QScrollBar::sub-line {
    width: 0px;
    height: 0px;
}
QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

/* ---------- 对话框 ---------- */

QDialog {
    background: @windowBg;
    border-radius: 10px;
}

/* ---------- 工具提示（圆角） ---------- */

QToolTip {
    background: @tooltipBg;
    color: @tooltipFg;
    border: 1px solid @tooltipBorder;
    border-radius: 6px;
    padding: 5px 10px;
}

/* ---------- 进度条 ---------- */

QProgressBar {
    background: @separatorColor;
    border: none;
    border-radius: 4px;
    height: 6px;
}
QProgressBar::chunk {
    background: @accent;
    border-radius: 4px;
}

/* ---------- 弹窗（QMessageBox 样式美化） ---------- */

QMessageBox {
    background: @windowBg;
}

QMessageBox QLabel {
    color: @editorFg;
}

QMessageBox QPushButton {
    background: transparent;
    color: @editorFg;
    border: 1px solid @separatorColor;
    border-radius: 6px;
    padding: 8px 20px;
    min-height: 32px;
    min-width: 80px;
    font-weight: 500;
}

QMessageBox QPushButton:hover {
    background: @menuHoverBg;
    border-color: @accent;
}

QMessageBox QPushButton:pressed {
    background: @menuPressedBg;
}

QMessageBox QPushButton:default {
    background: @accent;
    color: @windowBg;
    border: none;
    font-weight: 600;
}

QMessageBox QPushButton:default:hover {
    background: @accentHover;
}

