{
    "schemaVersion": 1,
    "id": "vscode-light-plus",
    "name": "VS Code Light+",
    "description": "对齐 VS Code 默认浅色配色，紧凑 IDE 密度。",
    "dark": false,
    "capabilities": [
        "colors",
        "metrics"
    ],
    "colors": {
        "accent": "#007acc",
        "accentHover": "#006bb4",
        "windowBg": "#ffffff",
        "titleBarBg": "#dddddd",
        "titleBarText": "#333333",
        "titleBarMutedFg": "#8f8f8f",
        "brandSub": "#8f8f8f",
        "separatorColor": "#e5e5e5",
        "menuFg": "#333333",
        "menuHoverBg": "#e8e8e8",
        "menuPressedBg": "#dadada",
        "winButtonHoverBg": "#e8e8e8",
        "winCloseHoverBg": "#d9534f",
        "activityBarBg": "#f3f3f3",
        "activityHoverBorder": "#939393",
        "sidebarBg": "#f3f3f3",
        "sidebarTitleFg": "#8f8f8f",
        "sidebarText": "#333333",
        "sidebarHoverBg": "#e8e8e8",
        "sidebarSelectedBg": "#cde3f6",
        "sidebarSelectedFg": "#1e1e1e",
        "sidebarButtonHoverBg": "#e8e8e8",
        "welcomeHintFg": "#8f8f8f",
        "statusBarBg": "#007acc",
        "statusBarFg": "#333333",
        "statusBarBorder": "#e5e5e5",
        "tabBarBg": "#f3f3f3",
        "tabFg": "#8f8f8f",
        "tabBg": "#f3f3f3",
        "tabActiveBg": "#ffffff",
        "tabActiveFg": "#333333",
        "tabHoverBg": "#e8e8e8",
        "editorBg": "#ffffff",
        "editorFg": "#333333",
        "currentLineBg": "#0f82cf",
        "selectionBg": "#59a9de",
        "lineNumberFg": "#b1b1b1",
        "lineNumberActiveFg": "#333333",
        "scrollbarHandle": "#c6c6c6",
        "scrollbarHandleHover": "#a3a3a3",
        "menuBg": "#ffffff",
        "menuBorder": "#e5e5e5",
        "menuItemHoverBg": "#e8e8e8",
        "menuItemHoverFg": "#333333",
        "menuDisabledFg": "#b8b8b8",
        "tooltipBg": "#ffffff",
        "tooltipFg": "#333333",
        "tooltipBorder": "#e5e5e5",
        "dialogBg": "#ffffff",
        "buttonFg": "#ffffff",
        "buttonBg": "#007acc",
        "buttonHover": "#006eb8",
        "splitterHandle": "#e5e5e5",
        "searchHighlight": "#4ca2db",
        "activityIconFg": "#333333",
        "activityIconDisabledFg": "#b8b8b8",
        "sashColor": "#d3d3d3",
        "syntax.comment": "#008000",
        "syntax.keyword": "#0000ff",
        "syntax.string": "#a31515",
        "syntax.number": "#098658",
        "syntax.function": "#795e26",
        "syntax.method": "#795e26",
        "syntax.constructor": "#267f99",
        "syntax.type": "#267f99",
        "syntax.class": "#267f99",
        "syntax.struct": "#267f99",
        "syntax.builtin": "#0070c1",
        "syntax.constant": "#098658",
        "syntax.boolean": "#098658",
        "syntax.property": "#001080",
        "syntax.field": "#001080",
        "syntax.parameter": "#333333",
        "syntax.variable": "#333333",
        "syntax.operator": "#8f8f8f",
        "syntax.punctuation": "#8f8f8f",
        "syntax.tag": "#001080",
        "syntax.attribute": "#e50000",
        "syntax.namespace": "#0070c1",
        "syntax.module": "#0070c1",
        "syntax.label": "#267f99",
        "syntax.escape": "#a31515",
        "syntax.regexp": "#a31515",
        "syntax.include": "#0000ff",
        "syntax.annotation": "#267f99",
        "syntax.macro": "#0000ff"
