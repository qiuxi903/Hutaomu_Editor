    "metrics": {
        "uiDensity": "compact",
        "tabHeight": 32,
        "treeRowHeight": 22,
        "editorFontFamily": "Consolas, Cascadia Mono, monospace",
        "editorFontSize": 14,
        "scrollbarWidth": 10,
        "cornerRadius": 3,
        "cornerRadiusLarge": 5,
        "fontSizeSmall": 12,
        "fontSizeNormal": 13,
        "menuItemPaddingV": 5
